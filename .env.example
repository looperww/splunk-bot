# Splunk
# Required when DEMO_MODE is false.
SPLUNK_BASE_URL=https://splunk.example.com:8089
SPLUNK_TOKEN=
AME_EVENTS_PATH=/services/ame_events
# Splunk Enterprise 10.x supports the v2 export endpoint.
SPLUNK_SEARCH_PATH=/services/search/v2/jobs/export
# Optional comma-separated allowlist, e.g. security,main
SPLUNK_ALLOWED_INDEXES=

# AI
# mock keeps the UI runnable without an AI credential.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local UI testing
DEMO_MODE=false
