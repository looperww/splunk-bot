# Copy to .env for Docker Compose.
# chmod 600 .env
# Do not commit the real file.

# PostgreSQL
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Set true only when the app is served over HTTPS. The first app account is
# created through the browser setup screen and is stored as a password hash in PostgreSQL.
AUTH_COOKIE_SECURE=false

# Token encryption
# Generate with: openssl rand -base64 32
SPLUNK_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Optional server-side search policy.
SPLUNK_ALLOWED_INDEXES=

# OpenAI is optional. Without a key the app uses local Splunk test mode.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

DEMO_MODE=false

# Optional corporate outbound proxy. These are passed into the application
# container and used by Node fetch for OpenAI API requests.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,splunk-bot-db,.bce.lu
