# Copy to .env.docker and chmod 600.
# This file is for Docker Compose only. Do not commit the real file.

# PostgreSQL
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Token encryption
# Generate with: openssl rand -base64 32
SPLUNK_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Splunk/AME connection values are entered in the web UI.
# These legacy variables are intentionally no longer required:
# SPLUNK_BASE_URL=
# SPLUNK_TOKEN=

# Optional server-side search policy.
# Leave empty to use the indexes granted to the Splunk token.
SPLUNK_ALLOWED_INDEXES=

# AI is optional. With no key, the app automatically uses local Splunk test mode.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

DEMO_MODE=false
